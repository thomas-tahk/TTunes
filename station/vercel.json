{
  "framework": "vite",
  "buildCommand": "npm run build",
  "crons": [{ "path": "/api/cron/refresh", "schedule": "0 9 * * *" }],
  "rewrites": [
    { "source": "/api/owner/:path*", "destination": "/api/owner?route=:path*" },
    { "source": "/api/auth/:path*", "destination": "/api/auth?route=:path*" }
  ]
}
