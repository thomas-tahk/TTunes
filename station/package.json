{
  "name": "ttunes-station",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "sync:shared": "node scripts/copy-shared.mjs",
    "dev": "npm run sync:shared && vite",
    "build": "npm run sync:shared && vite build && node scripts/migrate-on-deploy.mjs",
    "typecheck": "npm run sync:shared && tsc --noEmit",
    "check:build": "node scripts/check-build.mjs",
    "db:up": "docker compose up -d --wait",
    "db:bouncer": "docker compose --profile bouncer up -d --wait bouncer",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "preview": "npm run sync:shared && node scripts/preview.mjs",
    "e2e": "npm run sync:shared && node test/e2e/sync.e2e.mjs",
    "e2e:playback": "npm run sync:shared && node test/e2e/playback.e2e.mjs",
    "e2e:paused": "npm run sync:shared && node test/e2e/pausedowner.e2e.mjs",
    "e2e:unplayable": "npm run sync:shared && node test/e2e/unplayable.e2e.mjs",
    "e2e:slowstart": "npm run sync:shared && node test/e2e/slowstart.e2e.mjs",
    "e2e:indicator": "npm run sync:shared && node test/e2e/indicator.e2e.mjs",
    "e2e:layout": "npm run sync:shared && node test/e2e/layout.e2e.mjs",
    "e2e:stacked": "npm run sync:shared && node test/e2e/stacked.e2e.mjs",
    "e2e:theset": "npm run sync:shared && node test/e2e/theset.e2e.mjs",
    "pretest": "npm run sync:shared && npm run db:up",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.63.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^5.0.5"
  }
}
