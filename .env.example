# For `docker compose up` (home lab). Copy to .env and fill in. Never commit .env.
OWNER_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
# Behind your own HTTPS reverse proxy:
COOKIE_SECURE=false
TRUST_PROXY=
# Host port for the app
TTUNES_PORT=18080
# Credentials for the bundled Postgres and MinIO (change these on a real server)
POSTGRES_PASSWORD=ttunes-pg-secret
MINIO_ROOT_USER=ttunes
MINIO_ROOT_PASSWORD=ttunes-minio-secret
